-- 应用定理 11：峰值层不能确定性决定准确率
theorem not_function_of_peaklayer :
    ¬ ∃ f : Int → Int, ∀ c : Cond, peakAcc c = f (peakMetric c) :=
  MethodologyCore.not_function_of peakMetric peakAcc
    (e1 := 0) (e2 := 1) (by decide) (by decide)

